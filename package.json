{
  "name": "hwagfu-frameui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "dev": "pnpm --filter @hwagfu/frameui dev",
    "docs:dev": "pnpm --filter frameui-docs dev",
    "docs:build": "pnpm --filter frameui-docs build",
    "docs:start": "pnpm --filter frameui-docs start",
    "typecheck": "pnpm -r typecheck"
  }
}
