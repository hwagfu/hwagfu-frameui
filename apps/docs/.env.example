# Copy to .env.local for local dev. On Vercel, set these under
# Project → Settings → Environment Variables.

# Account for the docs login page.
DOCS_USERNAME=
DOCS_PASSWORD=
# ≥ 32 random characters. Generate one with: openssl rand -base64 32
DOCS_SESSION_SECRET=

# GitHub personal access token (classic) with ONLY the read:packages scope.
# Shown to signed-in users on /docs/access so they can install @hwagfu/frameui.
FRAMEUI_REGISTRY_TOKEN=
